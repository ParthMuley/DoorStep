# DOORSTEP DEMO - copy to .env and fill in locally. Never commit .env or real secrets.

# --- Feature flags (safe defaults) ---
SIMULATION_MODE=true
USE_PHOTON=false
USE_BASE44=false
USE_CARDS=false
USE_LLM_INTENT=false

# --- Backend (Developer B's FastAPI). Empty = coordinator uses the in-memory FakeBackend ---
DOORSTEP_API_URL=
DOORSTEP_API_PORT=8000
DEMO_AUTH_TOKEN=change-me-local-demo-token

# --- Fetch.ai agents (Developer A). Seeds are private keys: use long random strings, never commit ---
COORDINATOR_SEED=
TRANSPORT_SEED=
DESTINATION_SEED=
COORDINATOR_PORT=8101
TRANSPORT_PORT=8102
DESTINATION_PORT=8103
# Filled after first start (addresses are printed in the agent logs)
TRANSPORT_AGENT_ADDRESS=
DESTINATION_AGENT_ADDRESS=
AGENTVERSE_API_KEY=
# With the key set, agents default to Agentverse mailbox mode; set false for local-only dev
PROVIDER_USE_MAILBOX=
# Agentverse plans cap agents per account: comma-separated agent names to run on local endpoints instead
LOCAL_ONLY_AGENTS=

# --- ASI:One LLM (optional intent fallback only; never safety decisions) ---
ASI_ONE_API_KEY=
# asi1-mini (default, fastest) | asi1 | asi1-ultra
ASI_ONE_MODEL=asi1-mini

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon-demo
SENTRY_TRACES_SAMPLE_RATE=1.0

# Developer B backend DB path
DOORSTEP_DB_PATH=var/doorstep_demo.db

# --- V2 (contract v2.0) ---
# B's MongoDB (local or Atlas). Tests use mongomock.
MONGODB_URI=mongodb://localhost:27017
USE_MONGOMOCK=false
# Calamity Checker: empty = ${DOORSTEP_API_URL}/demo/feeds/caloes (synthetic). Live Cal OES is display-only.
ALERT_FEED_URL=
ALERT_POLL_INTERVAL_SECONDS=120
NEWS_POLL_INTERVAL_SECONDS=120
# HERE Routing v8 (Route agent). Never commit.
HERE_API_KEY=
# Extra agent seeds/ports (Doorstep reuses COORDINATOR_SEED/PORT)
CALAMITY_SEED=
MATCHING_SEED=
NEWS_SEED=
ROUTE_SEED=
POSTCALAMITY_SEED=
ESCALATION_SEED=
NETWORK_SEED=

# Contract v2.1: only the Volunteer Network agent and B's backend hold this (X-Agent-Token). Never commit a real value.
NETWORK_AGENT_TOKEN=
# B: false when our Escalation agent runs (it acknowledges escalations)
AUTO_ESCALATION_ACK=false
