# DOORSTEP DEMO - copy to .env and fill in locally. Never commit .env or real secrets.

# --- Feature flags (safe defaults) ---
SIMULATION_MODE=true
USE_PHOTON=false
USE_BASE44=false
USE_CARDS=false
USE_LLM_INTENT=false

# --- Backend (Developer B's FastAPI). Empty = coordinator uses the in-memory FakeBackend ---
DOORSTEP_API_URL=
DOORSTEP_API_PORT=8000
DEMO_AUTH_TOKEN=change-me-local-demo-token

# --- Fetch.ai agents (Developer A). Seeds are private keys: use long random strings, never commit ---
COORDINATOR_SEED=
TRANSPORT_SEED=
DESTINATION_SEED=
COORDINATOR_PORT=8101
TRANSPORT_PORT=8102
DESTINATION_PORT=8103
# Filled after first start (addresses are printed in the agent logs)
TRANSPORT_AGENT_ADDRESS=
DESTINATION_AGENT_ADDRESS=
AGENTVERSE_API_KEY=

# --- ASI:One LLM (optional intent fallback only; never safety decisions) ---
ASI_ONE_API_KEY=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon-demo
SENTRY_TRACES_SAMPLE_RATE=1.0
